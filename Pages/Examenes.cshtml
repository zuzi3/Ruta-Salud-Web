@page
@model CarnetSaludWeb.Pages.ExamenesModel
@{
    ViewData["Title"] = "Mis Exámenes y Resultados";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12 mb-3 d-flex align-items-center">
            <i class="bi bi-flask text-primary fs-2 me-2"></i>
            <h2 class="fw-bold text-primary mb-0">Mis Exámenes y Resultados</h2>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <!-- Pestañas superiores -->
            <ul class="nav nav-tabs mb-3 border-bottom">
                <li class="nav-item">
                    <a class="nav-link active fw-bold" href="#">Mis Exámenes</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-secondary" asp-page="/MiDoctor">Mi Doctor</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-secondary" asp-page="/MisCitas">Próximas Horas</a>
                </li>
            </ul>

            <h4 class="fw-bold text-primary">Listado General de Exámenes</h4>
            <p class="text-muted small">Historial completo de exámenes registrados en el sistema.</p>

            <div class="table-responsive">
                <table class="table table-hover align-middle border">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha</th>
                            <th>Examen / Título</th>
                            <th>Doctor</th>
                            <th class="text-end">Resultado / Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Examenes != null && Model.Examenes.Any())
                        {
                            @foreach (var examen in Model.Examenes)
                            {
                                <tr>
                                    <td class="fw-bold">@examen.Fecha</td>
                                    <td>
                                        <div class="fw-bold text-dark">@examen.Titulo</div>
                                        <small class="text-muted">Cat: @examen.Categoria</small>
                                    </td>
                                    <td>Dr(a): @examen.Doctor</td>
                                    <td class="text-end">
                                        @if (!string.IsNullOrEmpty(examen.ArchivoPdf))
                                        {
                                            <a href="@examen.ArchivoPdf" target="_blank" class="btn btn-success btn-sm">
                                                <i class="bi bi-file-earmark-pdf-fill me-1"></i> Disponible PDF
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Sin PDF</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No se encontraron exámenes registrados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>