@page
@model CarnetSaludWeb.Pages.NosotrosModel
@{
    ViewData["Title"] = "Sobre Nosotros - Ruta Salud Digital";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Header principal -->
            <div class="text-center mb-5">
                <h1 class="fw-bold carnet-texto-dinamico display-5 mb-2">Nuestra Historia</h1>
                <p class="fs-5" style="color: #3a6794;">Innovación y continuidad en la gestión de salud digital en Chile</p>
            </div>

            <!-- Historia / Contexto -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h3 class="fw-bold carnet-texto-dinamico display-5 mb-2">El Origen de Ruta Salud Digital</h3>
                    <p class="card-text">
                        <strong>Ruta Salud Digital</strong> nació como una iniciativa tecnológica orientada a resolver la fragmentación 
                        de la información médica de las personas. En los sistemas de atención tradicionales, las fichas clínicas, 
                        los resultados de exámenes y el historial de citas suelen encontrarse dispersos en múltiples centros asistenciales.
                    </p>
                    <p class="card-text">
                        Con el objetivo de otorgar el control de la información clínica directamente al paciente, nuestro equipo diseñó un 
                        ecosistema web y móvil capaz de centralizar atenciones, vigilar antecedentes médicos y facilitar la interacción entre usuarios y profesionales de la salud en tiempo real.
                    </p>
                </div>
            </div>

            <!-- Pilares del Proyecto -->
            <div class="row text-center mb-4">
                <div class="col-md-4 mb-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <div class="fs-1 text-primary mb-2">📋</div>
                            <h5 class="fw-bold">Centralización</h5>
                            <p class="text-muted small">Acceso unificado a fichas clínicas, diagnósticos y exámenes desde cualquier dispositivo.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <div class="fs-1 text-success mb-2">🔒</div>
                            <h5 class="fw-bold">Seguridad y Privacidad</h5>
                            <p class="text-muted small">Resguardo estricto de datos sensibles bajo los estándares de la Ley N° 19.628.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <div class="fs-1 text-info mb-2">📅</div>
                            <h5 class="fw-bold">Autogestión</h5>
                            <p class="text-muted small">Agendamiento y anulación de citas médicas de forma expedita e interactiva.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Equipo de Desarrollo -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h4 class="fw-bold carnet-texto-dinamico display-5 mb-2">Equipo de Desarrollo</h4>
                    <p class="text-muted">Plataforma desarrollada por el equipo de ingeniería del proyecto Ruta Salud Digital:</p>
                    <ul class="list-inline mb-0">
                        <li class="list-inline-item me-3"><strong>• Lucy González</strong></li>
                        <li class="list-inline-item me-3"><strong>• Emely Salas</strong></li>
                        <li class="list-inline-item me-3"><strong>• Jorge Marifil</strong></li>
                        <li class="list-inline-item"><strong>• Álvaro Sarmientos</strong></li>
                        <li class="list-inline-item"><strong>• Johan Suarez</strong></li>
                        <li class="list-inline-item"><strong>• Nelson Riveros</strong></li>
                    </ul>
                </div>
            </div>

        </div>
    </div>
</div>