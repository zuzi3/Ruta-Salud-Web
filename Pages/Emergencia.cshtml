@page "{rut?}"
@model CarnetSaludWeb.Pages.EmergenciaModel
@{
    ViewData["Title"] = "Ficha Médica de Emergencia";
}

<div class="container py-4" style="max-width: 500px;">
    @if (!Model.PacienteEncontrado)
    {
        <div class="alert alert-danger text-center shadow-sm rounded-4 p-4 mx-auto">
            <i class="bi bi-exclamation-triangle-fill fs-1 text-danger d-block mb-2"></i>
            <h4 class="fw-bold">Paciente no encontrado</h4>
            <p class="mb-0">El código QR escaneado no corresponde a un usuario registrado en RutaSalud.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm rounded-4 border-0 overflow-hidden">
            <!-- Encabezado Ficha -->
            <div class="bg-danger text-white text-center py-3">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>FICHA DE EMERGENCIA
                </h5>
                <small class="text-white-50">RutaSalud — Sistema de Respuesta Rápida</small>
            </div>

            <div class="card-body p-4">
                <!-- Nombre y RUT -->
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-dark mb-1">@Model.Paciente.Nombre</h2>
                    <span class="badge bg-secondary fs-6">RUT: @Model.Paciente.Rut</span>
                </div>

                <hr />

                <!-- Datos Médicos del Paciente -->
                <div class="row g-3">
                    <div class="col-6">
                        <div class="p-3 bg-light rounded-3 text-center border">
                            <small class="text-muted d-block fw-bold mb-1">GRUPO SANGUÍNEO</small>
                            <span class="fs-5 fw-bold text-danger">
                                <i class="bi bi-droplet-fill me-1"></i>@Model.Paciente.GrupoSanguineo
                            </span>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="p-3 bg-light rounded-3 text-center border">
                            <small class="text-muted d-block fw-bold mb-1">ALERGIAS</small>
                            <span class="fs-6 fw-bold text-dark">
                                @(!string.IsNullOrWhiteSpace(Model.Paciente.Alergias) ? Model.Paciente.Alergias : "Sin alergias")
                            </span>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="p-3 bg-warning bg-opacity-10 rounded-3 border border-warning">
                            <small class="text-warning-emphasis d-block fw-bold mb-1">
                                <i class="bi bi-activity me-1"></i>CONDICIONES MÉDICAS CRÓNICAS
                            </small>
                            <span class="fs-6 text-dark fw-semibold">
                                @(!string.IsNullOrWhiteSpace(Model.Paciente.Condiciones) ? Model.Paciente.Condiciones : "Sin condiciones registradas")
                            </span>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Botón Directo para Llamar al Contacto -->
                <div class="d-grid gap-2">
                    <a href="tel:@Model.Paciente.ContactoEmergencia" class="btn btn-danger btn-lg fw-bold rounded-pill shadow-sm">
                        <i class="bi bi-telephone-fill me-2"></i> LLAMAR A CONTACTO (@Model.Paciente.ContactoEmergencia)
                    </a>
                </div>
            </div>

            <div class="card-footer bg-light text-center py-2 text-muted small">
                Escaneado desde Llavero QR Físico RutaSalud
            </div>
        </div>
    }
</div>