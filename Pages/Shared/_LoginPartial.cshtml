<ul class="navbar-nav align-items-center">
@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <li class="nav-item">
        <span class="nav-link text-white-50 me-2">
            Hola, <strong class="text-white">@User.Identity.Name</strong>
        </span>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-page="/Index" asp-page-handler="Logout" method="post">
            <button type="submit" class="nav-link btn btn-link text-white fw-bold px-0 border-0" style="text-decoration: underline;">
                Cerrar Sesión
            </button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-white" asp-page="/Cuenta/IniciarSesion">Iniciar Sesión</a>
    </li>

    <li class="nav-item">
        <a class="nav-link text-white fw-bold" asp-page="/Cuenta/Registrarse">Registrarse</a>
    </li>
}
</ul>